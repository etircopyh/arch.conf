              "web_search_exa": true,
            },
          },
        },
      },
    },
    "enable_feedback": false,
    "default_profile": "write",
    "default_model": {
      "provider": "google",
      "model": "glm-5",
    },
    "model_parameters": [],
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": true,
    "expand_edit_card": true,
    "expand_terminal_card": true,
    "show_turn_stats": true,
    "message_editor_min_lines": 6,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 300,
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "replace": "underline",
      "visual": "block",
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_value_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": true,
    },
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "minimap": {
    "show": "auto",
    "display_in": "active_editor",
    "thumb": "hover",
    "thumb_border": "left_open",
    "max_width_columns": 80,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
      "padding": 7,
      "show_commit_summary": true,
      "min_column": 0,
    },
    "blame": {
      "show_avatar": true,
    },
    "hunk_style": "staged_hollow",
    "path_style": "file_name_first",
  },
  "terminal": {
    "shell": "system",
    "copy_on_select": true,
    "keep_selection_on_copy": true,
    "line_height": "comfortable",
    "max_scroll_history_lines": 50000,
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "edit_predictions": {
    "provider": "codestral",
    "mode": "eager",
    "disabled_globs": [
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/.dev.vars",
      "**/secrets.yml",
    ],
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
  },
  "context_server_timeout": 120,
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false,
  },
  "profiles": {
    "Python Dev": {
      "languages": {
        "Python": {
          "language_servers": ["basedpyright", "ruff"],
          "inlay_hints": {
            "enabled": true,
          },
        },
      },
    },
    "Presenting": {
      "buffer_font_size": 20,
      "ui_font_size": 20,
      "theme": "One Light",
    },
    "Focus": {
      "minimap": {
        "show": "never",
      },
      "git": {
        "inline_blame": {
          "enabled": false,
        },
      },
    },
  },
  "command_aliases": {
    "W": "workspace::Save",
    "WQ": "zed::Quit",
    "Q": "zed::Quit",
    "FF": "file_finder::Toggle",
    "G": "project_search::ToggleFocus",
    "TT": "terminal_panel::ToggleFocus",
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "preferred_line_length": 80,
      "allow_rewrap": "anywhere",
    },
    "JSON": {
      "tab_size": 2,
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": true,
        "show_type_hints": true,
      },
      "prettier": {
        "allowed": true,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true,
      },
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": true,
        "show_type_hints": true,
      },
      "prettier": {
        "allowed": true,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": true,
        "show_type_hints": true,
      },
      "prettier": {
        "allowed": true,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true,
      },
    },
    "Rust": {
      "tab_size": 4,
      "format_on_save": "on",
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "Shell Script": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["bash-language-server", "..."],
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2", "-s"],
        },
      },
      "inlay_hints": {
        "enabled": false,
      },
    },
    "Lua": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["lua-language-server", "..."],
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--indent-type", "Spaces", "--indent-width", "2", "-"],
        },
      },
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": true,
        "show_type_hints": true,
      },
    },
  },
}
