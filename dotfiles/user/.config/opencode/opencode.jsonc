    "mcp": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "",
        },
        "enabled": true
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "enabled": true
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "enabled": false
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=",
        "enabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?exaApiKey=",
        "enabled": true
      },
      "n8n-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "n8n-mcp"
        ],
        "environment": {
          "MCP_MODE": "stdio",
          "LOG_LEVEL": "error",
          "DISABLE_CONSOLE_OUTPUT": "true",
          "N8N_API_URL": "https://n8n",
          "N8N_API_KEY": "",
          "N8N_MCP_TELEMETRY_DISABLED": "true"
        },
        "enabled": false
      },
      "n8n-mcp-off": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "supergateway",
          "--streamableHttp",
          "https://n8n",
          "--header",
          "authorization:Bearer ",
        ],
        "enabled": false
      },
      "git": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "--mount",
          "type=bind,src=./,dst=/workspace",
          "mcp/git"
        ],
        "enabled": false
      }
    },
    "agent": {
      "explore": {
        "disable": false
      },
      "general": {
        "disable": true
      }
    }
  }
